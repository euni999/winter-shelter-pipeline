# .env 견본 (git에 커밋됨)
# .env는 비밀번호 때문에 커밋하지 않으므로, 다른 사람(또는 미래의 나)이
# 어떤 변수가 필요한지 알 수 있도록 이름만 남겨둔다.
# 사용법: cp .env.example .env 후 값 채우기
POSTGRES_USER=pipeline
POSTGRES_PASSWORD=
POSTGRES_DB=shelter

# 공공데이터포털 API 키
SHELTER_API_KEY=
KMA_API_KEY=

# Airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=
AIRFLOW_DB_NAME=airflow
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_JWT_SECRET=
AIRFLOW_FERNET_KEY=
